{
  "name": "xianyu-client",
  "version": "0.1.0",
  "private": true,
  "description": "Goodfish desktop client shell",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron . --dev",
    "build": "npm run build:renderer",
    "build:renderer": "vue-tsc --noEmit && vite build",
    "build:python": "cd python && .venv\\Scripts\\python.exe -m PyInstaller --clean --noconfirm xianyu-client.spec",
    "pack:win": "npm run build:renderer && npm run build:python && electron-builder --dir --win",
    "test:python": "cd python && .venv\\Scripts\\python.exe -m pytest"
  },
  "dependencies": {
    "element-plus": "^2.9.0",
    "lucide-vue-next": "^0.469.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}