<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bigbear</groupId>
        <artifactId>xxs-common-spring</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>goodfish_parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <description>
        goodfish 云端 Java 微服务聚合工程：统一多环境 profile、资源过滤与 proto 代码生成版本
    </description>

    <modules>
        <module>ruoyi-goodfish-admin</module>
        <module>goodfish-item-service</module>
        <module>goodfish-client-meta-service</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 资源过滤分隔符：只认 @...@，不认 ${...}（见下方 maven-resources-plugin 配置） -->
        <resource.delimiter>@</resource.delimiter>

        <!-- proto 代码生成（与 xxs-micro greeter-api 同款：binary-maven 按平台自动取 protoc） -->
        <protobuf-maven-plugin.version>5.1.4</protobuf-maven-plugin.version>
        <protobuf-java.version>4.34.2</protobuf-java.version>
        <grpc-java.version>1.80.0</grpc-java.version>
        <!-- xxs spring-grpc 框架（Spring Boot 4.1 官方 spring-grpc + nacos:// 发现/注册） -->
        <xxs-spring-grpc.version>1.0.0</xxs-spring-grpc.version>

        <!-- 注意：goodfish.proto.root 不在此处定义。
             父 pom 的 properties 会在“子模块上下文”中求值，${project.basedir} 指向的是子模块目录而非聚合工程目录，
             集中定义会随模块层级变化而错位。改由各子模块以 ${project.basedir}/../../../proto 显式声明。 -->
    </properties>

    <!-- 多环境配置：与 RuoYi-Cloud-Plus 根 pom 同构，供 application.yml 中的 @...@ 占位符替换 -->
    <profiles>
        <!-- 开发环境（默认激活）：与 llm-manage/config.yaml、RuoYi-Cloud-Plus dev profile 使用同一套 Nacos -->
        <profile>
            <id>dev</id>
            <properties>
                <profiles.active>dev</profiles.active>
                <nacos.server>10.0.0.8:8848</nacos.server>
                <nacos.ns>xhf</nacos.ns>
                <nacos.username>nacos</nacos.username>
                <nacos.password>nacos</nacos.password>
            </properties>
            <activation>
                <!-- 默认环境：不传 -P 时生效 -->
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>

        <!-- 生产环境：打包时显式指定 mvn -Pprod -->
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
                <nacos.server>127.0.0.1:8848</nacos.server>
                <!-- RuoYi 原 prod profile 遗漏了 nacos.ns，会导致 @nacos.ns@ 不被替换，这里补齐 -->
                <nacos.ns>prod</nacos.ns>
                <nacos.username>nacos</nacos.username>
                <nacos.password>nacos</nacos.password>
            </properties>
        </profile>
    </profiles>

    <build>
        <resources>
            <!-- 默认不过滤：mapper XML 里的 ${} 是 MyBatis 语法，绝不能被 Maven 替换 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application*.yml</exclude>
                    <exclude>bootstrap*.yml</exclude>
                    <exclude>logback*.xml</exclude>
                </excludes>
            </resource>
            <!-- 仅配置文件参与占位符替换（@profiles.active@ / @nacos.*@） -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application*.yml</include>
                    <include>bootstrap*.yml</include>
                    <include>logback*.xml</include>
                </includes>
            </resource>
        </resources>

        <pluginManagement>
            <plugins>
                <!-- 显式锁定分隔符为 @：application.yml 里的 ${spring.application.name} 是 Spring 运行时占位符，
                     必须原样保留，因此关闭 Maven 默认的 ${...} 分隔符 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <configuration>
                        <delimiters>
                            <delimiter>${resource.delimiter}</delimiter>
                        </delimiters>
                        <useDefaultDelimiters>false</useDefaultDelimiters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
