<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.bigbear</groupId>
        <artifactId>xxs-common-spring</artifactId>
        <version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>goodfish-item-service</artifactId>

    <description>
        goodfish 商品服务：商品同步落库、商品查询、提示词配置、提示词模板（内置只读）
    </description>

    <properties>
        <!-- gRPC 契约单一事实源目录（my-biz/xianyu/proto），相对本模块位置；可用 -Dgoodfish.proto.root 覆盖 -->
        <goodfish.proto.root>${project.basedir}/../../../../my-biz/xianyu/proto</goodfish.proto.root>
        <!-- proto 代码生成（与 xxs-micro greeter-api 同款：binary-maven 按平台自动取 protoc） -->
        <protobuf-maven-plugin.version>5.1.4</protobuf-maven-plugin.version>
        <protobuf-java.version>4.34.2</protobuf-java.version>
        <grpc-java.version>1.80.0</grpc-java.version>
        <!-- xxs spring-grpc 框架（Spring Boot 4.1 官方 spring-grpc + nacos:// 发现/注册） -->
        <xxs-spring-grpc.version>1.0.0</xxs-spring-grpc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 统一 io.grpc 版本：覆盖 spring-cloud-alibaba BOM 可能引入的旧版 io.grpc -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc-java.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-nacos</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-satoken</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-redis</artifactId>
        </dependency>

        <!-- xxs spring-grpc：Spring Boot 4.1 官方 spring-grpc（@GrpcService 等）
             ＋ nacos:// NameResolver ＋ gRPC 端口以 <appName>-grpc 双注册到 Nacos -->
        <dependency>
            <groupId>com.bigbear</groupId>
            <artifactId>xxs-spring-grpc-nacos</artifactId>
            <version>${xxs-spring-grpc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 由共享 proto 目录生成 Java message 与 gRPC service 代码 -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>${protobuf-maven-plugin.version}</version>
                <configuration>
                    <sourceDirectories>
                        <sourceDirectory>${goodfish.proto.root}</sourceDirectory>
                    </sourceDirectories>
                    <includes>
                        <include>item/v1/item.proto</include>
                        <include>account/v1/account.proto</include>
                        <include>llm/v1/llm.proto</include>
                    </includes>
                    <protoc kind="binary-maven">
                        <version>${protobuf-java.version}</version>
                    </protoc>
                    <plugins>
                        <plugin kind="binary-maven">
                            <groupId>io.grpc</groupId>
                            <artifactId>protoc-gen-grpc-java</artifactId>
                            <version>${grpc-java.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
