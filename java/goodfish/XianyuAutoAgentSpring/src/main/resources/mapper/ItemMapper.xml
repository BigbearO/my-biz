<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bigbear.goodfish.domain.mapper.ItemMapper">

    <select id="selectByItemId" resultType="com.bigbear.goodfish.domain.entity.Item">
        SELECT * FROM items
        WHERE item_id = #{itemId}
    </select>
</mapper>
