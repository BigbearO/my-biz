<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bigbear.goodfish.domain.mapper.MessageMapper">

    <select id="findByUserIdAndItemId" resultType="com.bigbear.goodfish.domain.entity.Message">
        SELECT * FROM messages
        WHERE user_id = #{userId} AND item_id = #{itemId}
        ORDER BY timestamp DESC
    </select>

    <select id="findByChatId" resultType="com.bigbear.goodfish.domain.entity.Message">
        SELECT * FROM messages
        WHERE chat_id = #{chatId}
        ORDER BY timestamp ASC
        LIMIT #{limit}
    </select>

    <select id="findRecentMessages" resultType="com.bigbear.goodfish.domain.entity.Message">
        SELECT * FROM messages
        ORDER BY timestamp DESC
        LIMIT #{limit}
    </select>

    <delete id="deleteExpiredMessages">
        DELETE FROM messages
        WHERE timestamp < #{expireTime}
    </delete>
</mapper>
