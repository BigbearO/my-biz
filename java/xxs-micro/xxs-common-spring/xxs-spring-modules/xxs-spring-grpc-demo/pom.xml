<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.bigbear</groupId>
    <artifactId>xxs-spring-modules</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>xxs-spring-grpc-demo</artifactId>

  <dependencies>
    <!-- 框架模块：官方 spring-grpc server/client 透传能力（@GrpcService / @ImportGrpcClients 等） -->
    <dependency>
      <groupId>com.bigbear</groupId>
      <artifactId>xxs-spring-grpc</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- Nacos 服务发现/注册 Starter：nacos:// NameResolver + gRPC 端口注册 -->
    <dependency>
      <groupId>com.bigbear</groupId>
      <artifactId>xxs-spring-grpc-nacos</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- Greeter 契约 SDK：生成 stub + 充血 GreeterClient -->
    <dependency>
      <groupId>com.bigbear</groupId>
      <artifactId>greeter-api</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- User 契约 SDK：生成 stub + 充血 UserClient -->
    <dependency>
      <groupId>com.bigbear</groupId>
      <artifactId>user-api</artifactId>
      <version>${revision}</version>
    </dependency>

    <!-- REST 入站，演示「HTTP → gRPC」全链路 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 可选：将 HTTP(8080) 以 spring.application.name 服务名注册到 Nacos；
         gRPC 端口(9090) 由 nacos starter 另以 <name>-grpc 服务名注册（双端口双注册）。 -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>

    <!-- 日志采集：结构化 JSON 推送到 Fluent Bit -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>8.0</version>
    </dependency>

    <!-- 分布式事务（Seata XA）：发起方集成，含 seata-spring-boot-starter 2.6.0 -->
    <dependency>
      <groupId>org.dromara</groupId>
      <artifactId>ruoyi-common-seata</artifactId>
      <version>6.0.0</version>
    </dependency>

    <!-- 多数据源（方案 B：dynamic-datasource 接管连接池，seata=true 走 XA 代理） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
      <version>4.5.0</version>
    </dependency>

    <!-- PostgreSQL JDBC 驱动 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- 连接池（HikariCP，dynamic-datasource 默认池）与 JdbcTemplate 依赖 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 打包为可执行 jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
