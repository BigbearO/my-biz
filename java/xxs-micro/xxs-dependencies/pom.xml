<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bigbear</groupId>
  <artifactId>xxs-dependencies</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>xxs-dependencies</name>
  <description>Centralized version management BOM for xxs-micro</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <hutool.version>5.8.40</hutool.version>
    <lombok.version>1.18.46</lombok.version>
    <guava.version>33.5.0-jre</guava.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <flex.version>1.11.7</flex.version>
    <fastexcel.version>1.3.0</fastexcel.version>
    <fesod.version>2.0.2-incubating</fesod.version>
    <sensitive.version>0.29.3</sensitive.version>
    <langchain.version>1.17.0</langchain.version>
    <langchain.community.version>1.17.0-beta27</langchain.community.version>
    <langgraph.version>1.8.20</langgraph.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- External BOMs (cross-tech-stack) -->
      <dependency>
        <groupId>cn.hutool</groupId>
        <artifactId>hutool-bom</artifactId>
        <version>${hutool.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-bom</artifactId>
        <version>${langchain.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-community-bom</artifactId>
        <version>${langchain.community.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.bsc.langgraph4j</groupId>
        <artifactId>langgraph4j-bom</artifactId>
        <version>${langgraph.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Utility -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>

      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- MapStruct -->
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${mapstruct.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- MyBatis-Flex -->
      <dependency>
        <groupId>com.mybatis-flex</groupId>
        <artifactId>mybatis-flex-core</artifactId>
        <version>${flex.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mybatis-flex</groupId>
        <artifactId>mybatis-flex-processor</artifactId>
        <version>${flex.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>com.mybatis-flex</groupId>
        <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
        <version>${flex.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mybatis-flex</groupId>
        <artifactId>mybatis-flex-spring-boot4-starter</artifactId>
        <version>${flex.version}</version>
      </dependency>

      <!-- Excel -->
      <dependency>
        <groupId>cn.idev.excel</groupId>
        <artifactId>fastexcel</artifactId>
        <version>${fastexcel.version}</version>
      </dependency>

      <!-- Fesod -->
      <dependency>
        <groupId>org.apache.fesodl</groupId>
        <artifactId>fesod</artifactId>
        <version>${fesod.version}</version>
      </dependency>

      <!-- Sensitive word -->
      <dependency>
        <groupId>com.github.houbb</groupId>
        <artifactId>sensitive-word</artifactId>
        <version>${sensitive.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
